<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SpotlightSearch</AssemblyName>
    <RootNamespace>SpotlightSearch</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    UseWindowsForms brings System.Drawing and System.Windows.Forms into the implicit
    using set, which makes Brush / Color / Pen / ContextMenu / RichTextBox ambiguous
    with their WPF counterparts. The tray icon is the only WinForms consumer, so the
    two global usings are dropped here and imported explicitly in that one file.
  -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
