<Window x:Class="SpotlightSearch.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spotlight 设置"
        Width="600"
        SizeToContent="Height"
        MaxHeight="760"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}"
        FontWeight="Bold"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FF111114" />
        <SolidColorBrush x:Key="FieldBrush" Color="#FF1B1B20" />
        <SolidColorBrush x:Key="FieldBorderBrush" Color="#FF2E2E36" />
        <SolidColorBrush x:Key="LabelBrush" Color="#B4FFFFFF" />
        <SolidColorBrush x:Key="HintBrush" Color="#73FFFFFF" />

        <Style x:Key="FieldStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#FF4CC2FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecretStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#FF4CC2FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B4FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip" CornerRadius="7" Padding="11,5"
                                Background="{StaticResource FieldBrush}"
                                BorderBrush="{StaticResource FieldBorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#FF3C3C46" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#1F4CC2FF" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#FF4CC2FF" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            <Border x:Name="Track" Grid.Column="1" Width="38" Height="21" CornerRadius="11"
                                    Background="#FF2A2A32" BorderThickness="0">
                                <Ellipse x:Name="Knob" Width="15" Height="15" Fill="#FFB9B9C2"
                                         HorizontalAlignment="Left" Margin="3,0,0,0" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#FF4CC2FF" />
                                <Setter TargetName="Knob" Property="Fill" Value="#FFFFFFFF" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HintBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="8" Background="#FF2A2A32">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#FF35353F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="8" Background="#FF4CC2FF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.86" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FF08131B" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" Background="#FF0B0B0E" BorderBrush="#22FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="24,20,20,0">
                <TextBlock Text="设置" FontSize="17" Foreground="#FFFFFFFF" />
                <Button Content="✕" Style="{StaticResource ActionButton}" Padding="10,4"
                        HorizontalAlignment="Right" Click="Cancel_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1" MaxHeight="560" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                <StackPanel Margin="24,0,24,8">

                    <TextBlock Text="搜索" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="快捷键" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="HotkeyBox" Style="{StaticResource FieldStyle}"
                             GotKeyboardFocus="HotkeyBox_GotFocus"
                             LostKeyboardFocus="HotkeyBox_LostFocus"
                             PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                    <TextBlock x:Name="HotkeyHint" Style="{StaticResource FieldLabel}"
                               Foreground="{StaticResource HintBrush}" FontSize="11" Margin="0,6,0,0"
                               Text="点击输入框后按下组合键即可设置，例如 Alt+Space、Ctrl+Alt+Space。Esc 取消，Backspace 清除。" />

                    <StackPanel Margin="0,16,0,0">
                        <CheckBox x:Name="AiDefaultCheck" Style="{StaticResource SwitchStyle}"
                                  Content="打开时直接进入 AI 模式" />
                        <CheckBox x:Name="HistoryCheck" Style="{StaticResource SwitchStyle}"
                                  Content="记录使用历史（影响排序）" Margin="0,12,0,0" />
                        <CheckBox x:Name="FileSearchCheck" Style="{StaticResource SwitchStyle}"
                                  Content="搜索磁盘文件" Margin="0,12,0,0" />
                        <CheckBox x:Name="AutoStartCheck" Style="{StaticResource SwitchStyle}"
                                  Content="开机自动启动" Margin="0,12,0,0" />
                    </StackPanel>

                    <Grid Margin="0,16,0,0">
                        <TextBlock x:Name="ResultCountLabel" Style="{StaticResource FieldLabel}" />
                        <Slider x:Name="ResultCountSlider" Minimum="4" Maximum="20"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Margin="0,26,0,0" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <TextBlock x:Name="FileBudgetLabel" Style="{StaticResource FieldLabel}" />
                        <Slider x:Name="FileBudgetSlider" Minimum="200" Maximum="5000"
                                TickFrequency="100" IsSnapToTickEnabled="True"
                                Margin="0,26,0,0" />
                    </Grid>

                    <TextBlock Text="AI" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="服务商" Style="{StaticResource FieldLabel}" />
                    <WrapPanel x:Name="ProviderPanel" />

                    <TextBlock Text="模型" Style="{StaticResource FieldLabel}" Margin="0,10,0,6" />
                    <TextBox x:Name="ModelBox" Style="{StaticResource FieldStyle}" />

                    <TextBlock Text="API Key（用 Windows DPAPI 加密后保存）" Style="{StaticResource FieldLabel}"
                               Margin="0,12,0,6" />
                    <PasswordBox x:Name="ApiKeyBox" Style="{StaticResource SecretStyle}" />
                    <TextBlock x:Name="KeyHint" Style="{StaticResource FieldLabel}"
                               Foreground="{StaticResource HintBrush}" FontSize="11" Margin="0,6,0,0" />

                    <TextBlock Text="自定义接口地址（选 Custom 时使用，OpenAI 兼容）" Style="{StaticResource FieldLabel}"
                               Margin="0,12,0,6" />
                    <TextBox x:Name="BaseUrlBox" Style="{StaticResource FieldStyle}" />

                    <TextBlock Text="危险操作" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="清空使用历史" Style="{StaticResource ActionButton}" Click="ClearHistory_Click" />
                        <Button Content="恢复默认设置" Style="{StaticResource ActionButton}" Margin="10,0,0,0"
                                Click="ResetDefaults_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Padding="24,14">
                <Grid>
                    <TextBlock x:Name="StatusLabel" Foreground="{StaticResource HintBrush}" FontSize="11"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Style="{StaticResource ActionButton}" Click="Cancel_Click" />
                        <Button Content="保存" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                                Click="Save_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
