<Window x:Class="SpotlightSearch.Windows.SpotlightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SpotlightSearch.Controls"
        Title="Spotlight"
        Width="968"
        Height="650"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Opacity="0"
        FontFamily="{StaticResource UiFont}"
        FontWeight="Bold"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F4FFFFFF" />
        <SolidColorBrush x:Key="TitleTextBrush" Color="#EDFFFFFF" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8AFFFFFF" />
        <SolidColorBrush x:Key="TertiaryTextBrush" Color="#8AFFFFFF" />
        <SolidColorBrush x:Key="ShellBrush" Color="#FF000000" />
        <SolidColorBrush x:Key="HoverItemBrush" Color="#10FFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF4CC2FF" />
        <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1F4CC2FF" />

        <conv:ResultHotkeyConverter x:Key="HotkeyConverter" />

        <Style x:Key="AiToolbarStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="5" Background="Transparent" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AiSuggestionStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#8C959E" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="Transparent" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#C8C8C8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeyBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#222228" />
            <Setter Property="BorderBrush" Value="#3C3C46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="9,3.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ThinScrollBarThumb" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Width="4" HorizontalAlignment="Center" CornerRadius="2" Background="#30FFFFFF" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Margin" Value="0,2,3,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThinScrollBarThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SpotlightContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{StaticResource ShellBrush}" BorderBrush="#22FFFFFF"
                                BorderThickness="1" CornerRadius="10" Padding="4">
                            <StackPanel IsItemsHost="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SpotlightMenuItemStyle" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Root" CornerRadius="6" Padding="12,7" Background="Transparent">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                              TextElement.FontFamily="{StaticResource UiFont}"
                                              TextElement.FontSize="12"
                                              TextElement.FontWeight="Bold"
                                              TextElement.Foreground="{StaticResource PrimaryTextBrush}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <EventSetter Event="MouseLeftButtonUp" Handler="ResultItem_MouseLeftButtonUp" />
            <EventSetter Event="MouseRightButtonUp" Handler="ResultItem_MouseRightButtonUp" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="7,2" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="HoverSurface" Background="{StaticResource HoverItemBrush}"
                                    CornerRadius="8" Opacity="0" />
                            <Border Padding="14,8">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.10" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <AdornerDecorator>
        <Grid>
            <!-- Solid silhouette behind the shell; the shadow lives on this wrapper. -->
            <Grid x:Name="ShellShadowHost"
                  Width="{Binding ActualWidth, ElementName=Shell}"
                  Height="{Binding ActualHeight, ElementName=Shell}"
                  Margin="0,16,0,0"
                  Opacity="{Binding Opacity, ElementName=Shell}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  IsHitTestVisible="False">
                <Grid.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4"
                                      Direction="270" Opacity="0.6" RenderingBias="Performance" />
                </Grid.Effect>
                <Border Background="Black" CornerRadius="{Binding CornerRadius, ElementName=Shell}" />
            </Grid>

            <Border x:Name="Shell"
                    Margin="124,16,124,0"
                    CornerRadius="14"
                    Background="{StaticResource ShellBrush}"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    VerticalAlignment="Top"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.12">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ShellScale" ScaleX="0.98" ScaleY="0.98" />
                        <TranslateTransform x:Name="ShellShake" />
                    </TransformGroup>
                </Border.RenderTransform>

                <Grid>
                    <Grid x:Name="ShellContent" ClipToBounds="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="64" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Search field: text left, mode badge and gear right. -->
                        <Grid Margin="22,0,20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid x:Name="SearchBoxContainer" Margin="0,0,16,0">
                                <TextBlock x:Name="AutocompleteText"
                                           FontFamily="{StaticResource UiFont}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Margin="1,2,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"><Run x:Name="AutocompleteTypedRun" Foreground="Transparent" /><Run x:Name="AutocompleteSuffixRun" Foreground="#78FFFFFF" /></TextBlock>

                                <TextBox x:Name="SearchBox"
                                         TextChanged="SearchBox_TextChanged"
                                         GotFocus="SearchBox_GotFocus"
                                         LostFocus="SearchBox_LostFocus"
                                         SelectionChanged="SearchBox_SelectionChanged"
                                         ContextMenuOpening="SearchBox_ContextMenuOpening"
                                         FontFamily="{StaticResource UiFont}"
                                         FontSize="20"
                                         FontWeight="Bold"
                                         Foreground="{StaticResource PrimaryTextBrush}"
                                         CaretBrush="Transparent"
                                         SelectionBrush="#FFFFFF"
                                         SelectionTextBrush="#C8C8C8"
                                         SelectionOpacity="0.35"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="2,2,0,0"
                                         VerticalContentAlignment="Center">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" />
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>

                                <Border x:Name="GlowingCaret"
                                        Width="2"
                                        Height="22"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="#FFFFFF"
                                        CornerRadius="1"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#FFFFFF" BlurRadius="10" ShadowDepth="0" Opacity="0.95" />
                                    </Border.Effect>
                                </Border>

                                <TextBlock x:Name="PlaceholderText"
                                           Text="搜索应用、文件、设置"
                                           FontFamily="{StaticResource UiFont}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#85FFFFFF"
                                           Margin="7,0,0,0"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Border x:Name="EscBadge"
                                    MouseLeftButtonDown="AiToggle_Click"
                                    Cursor="Hand"
                                    Grid.Column="1"
                                    Margin="0,0,14,0"
                                    Style="{StaticResource KeyBadgeStyle}">
                                <TextBlock x:Name="EscBadgeText"
                                           Text="TAB · AI"
                                           FontFamily="{StaticResource UiFont}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#D0D0D8" />
                            </Border>

                            <Button x:Name="SettingsButton"
                                    Grid.Column="2"
                                    Style="{StaticResource AiToolbarStyle}"
                                    Width="26" Height="26"
                                    ToolTip="设置"
                                    Click="SettingsButton_Click">
                                <TextBlock Text="&#xE713;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="15"
                                           Foreground="#FFFFFF"
                                           FontWeight="Normal" />
                            </Button>
                        </Grid>

                        <Border x:Name="ContentRegion"
                                Grid.Row="2"
                                BorderBrush="#14FFFFFF"
                                BorderThickness="0,1,0,0"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,6,0,7" ClipToBounds="True">
                                    <!-- ===================== AI panel ===================== -->
                                    <StackPanel x:Name="AiPanel" Visibility="Collapsed" Margin="20,10,20,4"
                                                TextElement.FontFamily="{StaticResource UiFont}"
                                                TextElement.FontWeight="Bold">
                                        <Grid x:Name="AiHeader" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="AiBackButton" Style="{StaticResource AiToolbarStyle}"
                                                        Click="AiBack_Click" Margin="0,0,10,0" ToolTip="返回搜索">
                                                    <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="12" Foreground="#C8C8C8" FontWeight="Normal" />
                                                </Button>
                                                <StackPanel x:Name="AiModelPill" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock x:Name="AiModeLabel" Foreground="#C8C8C8"
                                                               FontFamily="{StaticResource UiFont}" FontWeight="Bold"
                                                               FontSize="11.5" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="AiMetadata" Foreground="#8C959E"
                                                           FontFamily="{StaticResource UiFont}" FontWeight="Bold"
                                                           FontSize="10.5" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <Button x:Name="AiCopyButton" Style="{StaticResource AiToolbarStyle}"
                                                        Click="AiCopy_Click" Margin="0,0,6,0" ToolTip="复制回答">
                                                    <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="12" Foreground="#C8C8C8" FontWeight="Normal" />
                                                </Button>
                                                <Button x:Name="AiHistoryButton" Style="{StaticResource AiToolbarStyle}"
                                                        Click="AiHistory_Click" Margin="0,0,6,0" ToolTip="对话历史">
                                                    <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="12" Foreground="#C8C8C8" FontWeight="Normal" />
                                                </Button>
                                                <Button x:Name="AiNewChatButton" Style="{StaticResource AiToolbarStyle}"
                                                        Click="AiNewChat_Click" ToolTip="新对话">
                                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="11" Foreground="#C8C8C8" FontWeight="Normal" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <Border x:Name="AiWelcome" Padding="22,22" Margin="0,0,0,6" Background="Transparent">
                                            <StackPanel>
                                                <TextBlock Text="✦" FontFamily="{StaticResource UiFont}" FontSize="28"
                                                           FontWeight="Bold" Foreground="#C8C8C8"
                                                           HorizontalAlignment="Center" Margin="0,4,0,14" />
                                                <TextBlock x:Name="AiWelcomeTitle" FontFamily="{StaticResource UiFont}"
                                                           Foreground="#C8C8C8" FontSize="15" FontWeight="Bold"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock x:Name="AiWelcomeHint" FontFamily="{StaticResource UiFont}"
                                                           FontWeight="Bold" Foreground="#8C959E" FontSize="12"
                                                           Margin="0,6,0,16" TextAlignment="Center" TextWrapping="Wrap" />
                                                <WrapPanel HorizontalAlignment="Center">
                                                    <Button x:Name="AiPromptOne" Style="{StaticResource AiSuggestionStyle}"
                                                            Click="AiSuggestion_Click" Margin="0,0,8,6" />
                                                    <Button x:Name="AiPromptTwo" Style="{StaticResource AiSuggestionStyle}"
                                                            Click="AiSuggestion_Click" Margin="0,0,0,6" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <ScrollViewer x:Name="AiHistoryPanel" Visibility="Collapsed" MaxHeight="310"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      HorizontalContentAlignment="Stretch">
                                            <ScrollViewer.Resources>
                                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                                            </ScrollViewer.Resources>
                                            <StackPanel x:Name="AiHistoryItems" Margin="0,2,8,0" HorizontalAlignment="Stretch" />
                                        </ScrollViewer>

                                        <Grid ClipToBounds="True">
                                            <ScrollViewer x:Name="AiTranscriptScroll" MaxHeight="310"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ScrollViewer.Resources>
                                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                                                </ScrollViewer.Resources>
                                                <StackPanel x:Name="AiTranscript" Margin="0,0,8,0" />
                                            </ScrollViewer>
                                        </Grid>

                                        <Border x:Name="AiBottomActionRow" Margin="0,4,0,0" Padding="0">
                                            <Grid MinHeight="42">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <WrapPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock x:Name="AiStatus" TextWrapping="Wrap" HorizontalAlignment="Left"
                                                               TextAlignment="Left" FontFamily="{StaticResource UiFont}"
                                                               FontWeight="Bold" FontSize="11" VerticalAlignment="Center"
                                                               Margin="0,0,10,0" Visibility="Collapsed">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#A8ACB6" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="Tag" Value="error">
                                                                        <Setter Property="Foreground" Value="#FF6B6B" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <TextBlock x:Name="AiUsageText" FontFamily="{StaticResource UiFont}"
                                                               FontWeight="Bold" FontSize="11" Foreground="#8E929E"
                                                               VerticalAlignment="Center" Visibility="Collapsed" />
                                                </WrapPanel>

                                                <Button x:Name="AiStopButton" Grid.Column="1"
                                                        Width="36" Height="36" Cursor="Hand"
                                                        VerticalAlignment="Center" Visibility="Collapsed"
                                                        Click="AiStop_Click" ToolTip="停止生成">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Grid>
                                                                <Border x:Name="Bg" CornerRadius="18" Background="#EF4B53"
                                                                        BorderThickness="1" BorderBrush="#55FFFFFF" />
                                                                <Rectangle Width="12" Height="12" RadiusX="2.5" RadiusY="2.5"
                                                                           Fill="White" HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- ===================== results ===================== -->
                                    <ListBox x:Name="ResultsList"
                                             ItemContainerStyle="{StaticResource ResultItemStyle}"
                                             SelectionChanged="ResultsList_SelectionChanged"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             MaxHeight="440"
                                             VerticalAlignment="Top"
                                             AlternationCount="20"
                                             VirtualizingPanel.IsVirtualizing="False">
                                        <ListBox.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                                        </ListBox.Resources>
                                        <ListBox.Template>
                                            <ControlTemplate TargetType="ListBox">
                                                <ScrollViewer Focusable="False" CanContentScroll="False"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              VerticalScrollBarVisibility="Auto">
                                                    <Grid>
                                                        <Border x:Name="SelectionGlide"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Top"
                                                                Background="{StaticResource AccentSubtleBrush}"
                                                                CornerRadius="8"
                                                                Opacity="0"
                                                                IsHitTestVisible="False">
                                                            <Border.RenderTransform>
                                                                <TranslateTransform x:Name="SelectionGlideTransform" />
                                                            </Border.RenderTransform>
                                                            <Border Width="3" Margin="0,4" CornerRadius="1.5"
                                                                    Background="{StaticResource AccentBrush}"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Stretch" />
                                                        </Border>
                                                        <ItemsPresenter />
                                                    </Grid>
                                                </ScrollViewer>
                                            </ControlTemplate>
                                        </ListBox.Template>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid MinHeight="38" ToolTip="{Binding Target}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="46" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <Image Source="{Binding Icon}" Width="32" Height="32"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                        <TextBlock x:Name="FallbackGlyph"
                                                                   Text="{Binding Glyph}"
                                                                   FontFamily="{StaticResource IconFont}"
                                                                   FontSize="20"
                                                                   FontWeight="Normal"
                                                                   Foreground="#B4FFFFFF"
                                                                   Visibility="Collapsed"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                        <Path x:Name="ShortcutArrow" Visibility="Collapsed"
                                                              Width="14" Height="14" Stretch="Uniform"
                                                              HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                              Margin="-1,0,0,-1" Fill="#FFFFFF"
                                                              IsHitTestVisible="False"
                                                              Data="M1 15 L1 9 Q1 4 6 4 L8 4 L8 0 L16 6 L8 12 L8 8 L6 8 Q5 8 5 10 L5 15 Z">
                                                            <Path.Effect>
                                                                <DropShadowEffect Color="Black" BlurRadius="4"
                                                                                  ShadowDepth="1" Opacity="0.9"
                                                                                  RenderingBias="Performance" />
                                                            </Path.Effect>
                                                        </Path>
                                                    </Grid>

                                                    <StackPanel Grid.Column="1" Margin="4,0,16,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayTitle}"
                                                                   FontFamily="{StaticResource UiFont}"
                                                                   FontSize="15"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource TitleTextBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock x:Name="SubtitleText"
                                                                   Text="{Binding DisplaySubtitle}"
                                                                   Margin="0,2,0,0"
                                                                   FontFamily="{StaticResource UiFont}"
                                                                   FontSize="11.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource TertiaryTextBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <Border x:Name="HotkeyBadge" Grid.Column="2" Style="{StaticResource KeyBadgeStyle}">
                                                        <TextBlock x:Name="HotkeyText"
                                                                   Text="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource HotkeyConverter}}"
                                                                   FontFamily="{StaticResource UiFont}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="#99FFFFFF" />
                                                    </Border>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsShortcut}" Value="True">
                                                        <Setter TargetName="ShortcutArrow" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                        <Setter TargetName="FallbackGlyph" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Subtitle}" Value="">
                                                        <Setter TargetName="SubtitleText" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Text, ElementName=HotkeyText}" Value="">
                                                        <Setter TargetName="HotkeyBadge" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>

                                <Border x:Name="FailureBar" Grid.Row="1"
                                        BorderBrush="#12FFFFFF" BorderThickness="0,1,0,0"
                                        Padding="22,9" Visibility="Collapsed">
                                    <TextBlock x:Name="FailureText"
                                               FontFamily="{StaticResource UiFont}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#E8FFA894"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border x:Name="AiGlowBorder"
                            Margin="-1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            CornerRadius="14"
                            BorderThickness="1"
                            BorderBrush="#26FFFFFF"
                            IsHitTestVisible="False"
                            Opacity="0"
                            Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>
    </AdornerDecorator>
</Window>
